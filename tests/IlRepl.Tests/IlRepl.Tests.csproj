<Project Sdk="MSTest.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IlRepl.Tests</RootNamespace>
    <IsPackable>false</IsPackable>
    <MSTestAnalysisMode>Recommended</MSTestAnalysisMode>
    <GenerateTestingPlatformEntryPoint>false</GenerateTestingPlatformEntryPoint>
    <IncludeIlReplHostInOutput>true</IncludeIlReplHostInOutput>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <NoWarn>$(NoWarn);MSTESTEXP</NoWarn>
    <IncludeIlReplHostInOutput>true</IncludeIlReplHostInOutput>
    <IlReplHostPublishReadyToRun>true</IlReplHostPublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="Microsoft.VisualStudio.TestTools.UnitTesting" />
    <PackageReference Include="Microsoft.ILVerification" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="Protocol/Fixtures/highlight/*.il" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- ilasm and ildasm for the platform the tests run on: the ILAsm the session renders is assembled and run, and disassembly listings are checked against ildasm. -->
  <PropertyGroup>
    <IlasmRid>$(NETCoreSdkRuntimeIdentifier)</IlasmRid>
    <IlasmPackageVersion>10.0.11</IlasmPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageDownload Include="runtime.$(IlasmRid).Microsoft.NETCore.ILAsm" Version="[$(IlasmPackageVersion)]" />
    <PackageDownload Include="runtime.$(IlasmRid).Microsoft.NETCore.ILDAsm" Version="[$(IlasmPackageVersion)]" />
    <AssemblyMetadata Include="IlasmPackagePath" Value="$(NuGetPackageRoot)runtime.$(IlasmRid.ToLowerInvariant()).microsoft.netcore.ilasm/$(IlasmPackageVersion)/runtimes/$(IlasmRid)/native/" />
    <AssemblyMetadata Include="IldasmPackagePath" Value="$(NuGetPackageRoot)runtime.$(IlasmRid.ToLowerInvariant()).microsoft.netcore.ildasm/$(IlasmPackageVersion)/runtimes/$(IlasmRid)/native/" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/IlRepl/IlRepl.csproj"
                      AdditionalProperties="IncludeIlReplHostInOutput=false" />
    <ProjectReference Include="../../src/IlRepl.Engine/IlRepl.Engine.csproj"
                      AdditionalProperties="IncludeIlReplHostInOutput=false" />
    <ProjectReference Include="../../src/IlRepl.Host/IlRepl.Host.csproj"
                      AdditionalProperties="IncludeIlReplHostInOutput=false" />
    <ProjectReference Include="../../src/IlRepl.Protocol/IlRepl.Protocol.csproj"
                      AdditionalProperties="IncludeIlReplHostInOutput=false" />
    <ProjectReference Include="../../src/IlRepl.Tui/IlRepl.Tui.csproj"
                      AdditionalProperties="IncludeIlReplHostInOutput=false" />
    <ProjectReference Include="../../samples/Greeter/Greeter.csproj" ReferenceOutputAssembly="false" />
    <ProjectReference Include="../../samples/Fixtures/Fixtures.csproj" ReferenceOutputAssembly="false" />
  </ItemGroup>

  <Import Project="../../build/IlRepl.Host.targets" />
  <Import Project="../../build/IlRepl.PtyTests.targets" />

  <ItemGroup>
    <Compile Include="../Shared/*.cs" Link="Shared/%(Filename)%(Extension)" />
  </ItemGroup>

</Project>
