<Project>
  <!-- Scope restore assets to this host; NuGet's dependency walk does not honor reference property removal. -->
  <PropertyGroup Condition="'$(MSBuildProjectName)' == 'IlRepl.Host' and '$(_IlReplHostBuildDirectory)' != ''">
    <MSBuildProjectExtensionsPath>$(_IlReplHostBuildDirectory)obj/</MSBuildProjectExtensionsPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Version Condition="$(MSBuildProjectName.StartsWith('IlRepl'))">0.5.2</Version>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AnalysisLevel>latest</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <ContinuousIntegrationBuild Condition="'$(GITHUB_ACTIONS)' == 'true'">true</ContinuousIntegrationBuild>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
    <SuppressNETCoreSdkPreviewMessage>true</SuppressNETCoreSdkPreviewMessage>
  </PropertyGroup>

  <PropertyGroup>
    <Authors>Brandon Williams</Authors>
    <Copyright>Copyright (c) Brandon Williams</Copyright>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://willibrandon.github.io/ilrepl/</PackageProjectUrl>
    <RepositoryUrl>https://github.com/willibrandon/ilrepl</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PublishRepositoryUrl>true</PublishRepositoryUrl>
    <EmbedUntrackedSources>true</EmbedUntrackedSources>
    <DebugType>embedded</DebugType>
  </PropertyGroup>
</Project>
