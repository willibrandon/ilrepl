<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>IlRepl.Host</RootNamespace>
    <AssemblyName>ilrepl-host</AssemblyName>
    <IsAotCompatible>false</IsAotCompatible>
    <PublishAot>false</PublishAot>
    <SelfContained>false</SelfContained>
    <UseAppHost>false</UseAppHost>
    <RollForward>Major</RollForward>
    <IsPackable>false</IsPackable>
    <InvariantGlobalization>false</InvariantGlobalization>
    <TieredPGO>true</TieredPGO>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="StreamJsonRpc" />
    <PackageReference Include="Microsoft.Diagnostics.NETCore.Client" />
    <PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" ExcludeAssets="build;buildTransitive" />
    <PackageReference Include="NuGet.Commands" />
    <PackageReference Include="NuGet.Credentials" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="PortableRuntimeIdentifierGraph.json" />
    <None Update="THIRD-PARTY-NOTICES.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

  <!--
    A frontend publishes this host through a nested build that adds properties of its own. Any of them left on these
    references would start a second build of the engine and the protocol into the same folders, and in a solution build
    that second build runs while the first is still compiling. With all of them removed both builds are one.
  -->
  <PropertyGroup>
    <_NestedPublishProperties>IntermediateOutputPath;OutputPath;PublishAot;PublishDir;PublishReadyToRun</_NestedPublishProperties>
    <_NestedPublishProperties>$(_NestedPublishProperties);PublishSingleFile;PublishTrimmed;RuntimeIdentifier</_NestedPublishProperties>
    <_NestedPublishProperties>$(_NestedPublishProperties);RuntimeIdentifiers;SelfContained;UseAppHost</_NestedPublishProperties>
    <_NestedPublishProperties>$(_NestedPublishProperties);_IlReplHostBuild;_IlReplHostBuildDirectory</_NestedPublishProperties>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="../IlRepl.Engine/IlRepl.Engine.csproj" GlobalPropertiesToRemove="$(_NestedPublishProperties)" />
    <ProjectReference Include="../IlRepl.Protocol/IlRepl.Protocol.csproj" GlobalPropertiesToRemove="$(_NestedPublishProperties)" />
  </ItemGroup>

</Project>
