---
import Diagram from './Diagram.astro';

// The two processes and the channel between them. Each part is drawn like a transcript line:
// a tick in the gutter and a label, the way the stack echo sits under an instruction.
const left = [
  ['cli', 'command line',
    'System.CommandLine reads the options: a script path, -e lines, and the batch, quiet, and color flags. Batch '
    + 'mode is implied when input is piped.',
  ],
  ['tui', 'terminal UI',
    'The editor shows completion candidates and live stack state beside the transcript. '
    + 'Keyboard and mouse selection let you copy source and results.',
  ],
  ['batch', 'batch mode',
    'Scripts, -e, and piped input run without the UI. Newly supplied cell instructions can run at EOF; reopened source '
    + 'and trailing inspection or export commands do not trigger execution. An unclosed definition block is an error.',
  ],
  ['transcript', 'transcript and completion',
    'The frontend owns the transcript and retains acknowledged source. An embedded opcode and command catalog makes '
    + 'the editor available while the host starts.',
  ],
  ['client', 'host client',
    'Starts the host on the selected dotnet runtime and connects directly over a private Unix domain socket. '
    + 'Retained source remains available if the host exits.',
  ],
];

const right = [
  ['resolve', 'type and member resolution',
    'ILAsm member references resolve against the loaded assemblies. The return type and the [assembly] prefix are '
    + 'optional, short names resolve through System.*, and a method defined with .method resolves by its bare name.',
  ],
  ['stack', 'stack simulation',
    'A control-flow model validates accepted IL, including stack merges, branches, and exception regions. '
    + 'Diagnostics appear at the prompt before compilation.',
  ],
  ['emit', 'IL compilation',
    'Cells compile into collectible runtime assemblies. Definitions and edits are written with Mono.Cecil and retained '
    + 'across cells. .save writes a standalone assembly from the current source.',
  ],
  ['session', 'the session',
    'The declarations and methods that persist across cells, the cell being written, and the replayable state '
    + 'behind every listing, echo, and status line.',
  ],
  ['capture', 'console capture',
    'Console output streams in bounded chunks while a cell runs. The frontend acknowledges each chunk and avoids '
    + 'displaying it again when the final reply arrives.',
  ],
];

const channel = 'JSON-RPC carries submissions, read-only editing requests, source acknowledgements, and streamed output. '
  + 'The frontend and host communicate directly over a Unix domain socket on Windows, Linux, and macOS. '
  + 'Process supervision is independent of this connection.';

const rowY = (i: number) => 96 + i * 42;
---

<Diagram id="process-diagram" label="The terminal frontend, execution host, and direct connection">
  <svg viewBox="0 0 760 340" xmlns="http://www.w3.org/2000/svg" role="list">
    <defs>
      <marker id="il-arrow" viewBox="0 0 8 8" refX="7" refY="4" markerWidth="8" markerHeight="8" orient="auto-start-reverse">
        <path d="M0 0.5 L7.5 4 L0 7.5 Z" class="arrow" />
      </marker>
    </defs>

    <g class="process">
      <rect class="panel" x="20" y="36" width="310" height="284" rx="10" />
      <text class="panel-title" x="36" y="64">ilrepl</text>
      <text class="panel-sub" x="36" y="80">Native AOT front-end</text>
      {left.map(([part, name, text], i) => (
        <g data-part={part} data-title={name} data-text={text} tabindex="0" role="listitem" aria-label={`${name}. ${text}`}>
          <rect class="part-box" x="36" y={rowY(i)} width="278" height="32" rx="6" />
          <rect class="part-tick" x="46" y={rowY(i) + 9} width="3" height="14" rx="1.5" />
          <text x="60" y={rowY(i) + 21}>{name}</text>
        </g>
      ))}
    </g>

    <g class="process">
      <rect class="panel" x="430" y="36" width="310" height="284" rx="10" />
      <text class="panel-title" x="446" y="64">ilrepl-host</text>
      <text class="panel-sub" x="446" y="80">framework-dependent, runs on your dotnet</text>
      {right.map(([part, name, text], i) => (
        <g data-part={part} data-title={name} data-text={text} tabindex="0" role="listitem" aria-label={`${name}. ${text}`}>
          <rect class="part-box" x="446" y={rowY(i)} width="278" height="32" rx="6" />
          <rect class="part-tick" x="456" y={rowY(i) + 9} width="3" height="14" rx="1.5" />
          <text x="470" y={rowY(i) + 21}>{name}</text>
        </g>
      ))}
    </g>

    <g data-part="channel" data-title="JSON-RPC over a socket" data-text={channel} tabindex="0" role="listitem"
      aria-label={`JSON-RPC over a socket. ${channel}`} class="channel">
      <rect class="channel-hit" x="332" y="120" width="96" height="112" rx="6" />
      <text class="channel-label" x="380" y="140" text-anchor="middle">JSON-RPC</text>
      <path class="wire" d="M336 162 H420" marker-end="url(#il-arrow)" />
      <path class="wire-pulse" d="M336 162 H424" />
      <path class="wire" d="M424 192 H340" marker-end="url(#il-arrow)" />
      <path class="wire-pulse reply" d="M424 192 H336" />
      <text class="channel-label" x="380" y="222" text-anchor="middle">socket</text>
    </g>
  </svg>
</Diagram>
