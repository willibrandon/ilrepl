<Project>
  <!-- Hex1b 0.167.0 supplies glibc binaries only. Compile its matching PTY helper for tests running on musl. -->
  <Target Name="PrepareMuslPtyTestHelper">
    <PropertyGroup>
      <PtyNativeDirectory>$(IntermediateOutputPath)pty/$(NETCoreSdkRuntimeIdentifier)/</PtyNativeDirectory>
      <PtyNativeSource>$(MSBuildThisFileDirectory)../tests/native/hex1b/hex1binterop.c</PtyNativeSource>
      <PtyNativeAssetRid>$(NETCoreSdkRuntimeIdentifier.Replace('linux-musl-', 'linux-'))</PtyNativeAssetRid>
    </PropertyGroup>
  </Target>

  <Target Name="BuildMuslPtyTestHelper"
          DependsOnTargets="PrepareMuslPtyTestHelper"
          Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('linux-musl-'))"
          Inputs="$(PtyNativeSource);$(MSBuildThisFileFullPath)"
          Outputs="$(PtyNativeDirectory)libhex1binterop.so">
    <MakeDir Directories="$(PtyNativeDirectory)" />
    <Exec Command="cc -O2 -fPIC -shared -o &quot;$(PtyNativeDirectory)libhex1binterop.so&quot; &quot;$(PtyNativeSource)&quot; -lutil" />
    <ItemGroup>
      <FileWrites Include="$(PtyNativeDirectory)libhex1binterop.so" />
    </ItemGroup>
  </Target>

  <Target Name="CopyMuslPtyTestHelper"
          AfterTargets="CopyFilesToOutputDirectory"
          DependsOnTargets="BuildMuslPtyTestHelper"
          Condition="$(NETCoreSdkRuntimeIdentifier.StartsWith('linux-musl-'))">
    <!-- Match the native asset path in the test application's deps.json. -->
    <Copy SourceFiles="$(PtyNativeDirectory)libhex1binterop.so"
          DestinationFiles="$(TargetDir)runtimes/$(PtyNativeAssetRid)/native/libhex1binterop.so" />
    <ItemGroup>
      <FileWrites Include="$(TargetDir)runtimes/$(PtyNativeAssetRid)/native/libhex1binterop.so" />
    </ItemGroup>
  </Target>
</Project>
