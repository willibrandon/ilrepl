<Project>
  <!--
    Publishes the framework-dependent host and copies it into a "host" directory beside the
    importing project's output and publish directories. The tool starts it with the dotnet muxer.
  -->
  <PropertyGroup>
    <IlReplHostPublishReadyToRun Condition="'$(IlReplHostPublishReadyToRun)' == ''">false</IlReplHostPublishReadyToRun>
  </PropertyGroup>
  <PropertyGroup Condition="'$(IlReplHostPublishReadyToRun)' == 'true'">
    <_IlReplHostRuntimeIdentifier>$(RuntimeIdentifier)</_IlReplHostRuntimeIdentifier>
    <_IlReplHostRuntimeIdentifier Condition="'$(RuntimeIdentifier)' == '' or '$(RuntimeIdentifier)' == 'any'"
      >$(NETCoreSdkRuntimeIdentifier)</_IlReplHostRuntimeIdentifier>
  </PropertyGroup>
  <PropertyGroup>
    <_IlReplHostRoot>$(MSBuildThisFileDirectory)..\</_IlReplHostRoot>
    <_IlReplHostProject>$([System.IO.Path]::GetFullPath('$(_IlReplHostRoot)src\IlRepl.Host\IlRepl.Host.csproj'))</_IlReplHostProject>
    <_IlReplHostFlavor>portable</_IlReplHostFlavor>
    <_IlReplHostFlavor Condition="'$(_IlReplHostRuntimeIdentifier)' != ''"
      >$(_IlReplHostRuntimeIdentifier)-r2r</_IlReplHostFlavor>
    <!-- NormalizeDirectory also honors an absolute BaseIntermediateOutputPath. -->
    <_IlReplHostBase>$([MSBuild]::NormalizeDirectory('$(MSBuildProjectDirectory)', '$(BaseIntermediateOutputPath)'))</_IlReplHostBase>
    <_IlReplHostCache>$([MSBuild]::NormalizeDirectory('$(_IlReplHostBase)', 'host', '$(MSBuildProjectName)'))</_IlReplHostCache>
    <_IlReplHostBuildDirectory
      >$([MSBuild]::NormalizeDirectory('$(_IlReplHostCache)', '$(Configuration)', '$(_IlReplHostFlavor)'))</_IlReplHostBuildDirectory>
    <_IlReplHostOutputDirectory>$(_IlReplHostBuildDirectory)bin\</_IlReplHostOutputDirectory>
    <_IlReplHostIntermediateDirectory>$(_IlReplHostBuildDirectory)obj\</_IlReplHostIntermediateDirectory>
    <_IlReplHostPublishDirectory>$(_IlReplHostBuildDirectory)publish\</_IlReplHostPublishDirectory>

    <!-- MSBuild removes these after applying Properties, so never remove a property overridden below. -->
    <_IlReplHostPropertiesToRemove>
      BaseIntermediateOutputPath;MSBuildProjectExtensionsPath;ProjectAssetsFile;RestoreOutputPath;
      _CommandLineDefinedRuntimeIdentifier;_CommandLineDefinedSelfContained;_CommandLineDefinedOutputPath
    </_IlReplHostPropertiesToRemove>
    <_IlReplHostPropertiesToRemove>$([System.Text.RegularExpressions.Regex]::Replace(
      '$(_IlReplHostPropertiesToRemove)', '\s', ''))</_IlReplHostPropertiesToRemove>

    <_IlReplHostPublishProperties>
      Configuration=$(Configuration);TargetFramework=net10.0;RuntimeIdentifier=$(_IlReplHostRuntimeIdentifier);
      RuntimeIdentifiers=;PublishAot=false;SelfContained=false;PublishSingleFile=false;PublishTrimmed=false;
      PublishReadyToRun=$(IlReplHostPublishReadyToRun);UseAppHost=false;OutputPath=$(_IlReplHostOutputDirectory);
      IntermediateOutputPath=$(_IlReplHostIntermediateDirectory);_IlReplHostBuildDirectory=$(_IlReplHostBuildDirectory);
      PublishDir=$(_IlReplHostPublishDirectory);_IlReplHostBuild=true
    </_IlReplHostPublishProperties>

    <_IlReplHostExcludedFiles>$(_IlReplHostPublishDirectory)**\*.pdb;$(_IlReplHostPublishDirectory)**\*.xml</_IlReplHostExcludedFiles>
  </PropertyGroup>

  <Target Name="_PublishIlReplHost" Condition="'$(DesignTimeBuild)' != 'true'">
    <!-- A separate restore evaluation lets publish import the newly generated NuGet properties on a cold cache. -->
    <MSBuild Projects="$(_IlReplHostProject)"
             Targets="Restore"
             BuildInParallel="false"
             RemoveProperties="$(_IlReplHostPropertiesToRemove)"
             Properties="$(_IlReplHostPublishProperties);ExcludeRestorePackageImports=true" />
    <MSBuild Projects="$(_IlReplHostProject)"
             Targets="Publish"
             BuildInParallel="false"
             RemoveProperties="$(_IlReplHostPropertiesToRemove)"
             Properties="$(_IlReplHostPublishProperties)" />
  </Target>

  <Target Name="CleanIlReplHostBuild" BeforeTargets="Clean">
    <RemoveDir Directories="$(_IlReplHostBuildDirectory)" />
  </Target>

  <Target Name="CopyIlReplHostToOutput"
          AfterTargets="Build"
          DependsOnTargets="_PublishIlReplHost"
          Condition="'$(IncludeIlReplHostInOutput)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_IlReplHostOutputFile Include="$(_IlReplHostPublishDirectory)**\*" Exclude="$(_IlReplHostExcludedFiles)" />
    </ItemGroup>
    <RemoveDir Directories="$(OutDir)host" />
    <Copy SourceFiles="@(_IlReplHostOutputFile)"
          DestinationFolder="$(OutDir)host\%(_IlReplHostOutputFile.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyIlReplHostToPublish"
          AfterTargets="Publish"
          DependsOnTargets="_PublishIlReplHost"
          Condition="'$(IncludeIlReplHostInPublish)' == 'true' and '$(DesignTimeBuild)' != 'true'">
    <ItemGroup>
      <_IlReplHostPublishFile Include="$(_IlReplHostPublishDirectory)**\*" Exclude="$(_IlReplHostExcludedFiles)" />
    </ItemGroup>
    <RemoveDir Directories="$(PublishDir)host" />
    <Copy SourceFiles="@(_IlReplHostPublishFile)"
          DestinationFolder="$(PublishDir)host\%(_IlReplHostPublishFile.RecursiveDir)"
          SkipUnchangedFiles="true" />
  </Target>
</Project>
